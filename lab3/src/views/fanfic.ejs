<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= fanfic.title %></title>
    <link rel="stylesheet" href="/styles/fanfic.css">
</head>
<body>
    <div class="fanfic-page">
        
        <div class="card fanfic-header" style="position: relative;">
            <a href="/" class="btn btn--secondary" style="position: absolute; top: 20px; right: 20px;">Back to Home</a>
            <h1 class="fanfic-header__title"><%= fanfic.title %></h1>
            <div class="fanfic-header__desc"><%- fanfic.description %></div>
            
            <div class="fanfic-meta">
                <% if (fanfic.rating > 0) { %>
                    <span class="fanfic-tag fanfic-tag--rating">Rating: <%= fanfic.rating.toFixed(1) %></span>
                <% } %>
                <% fanfic.genre.forEach(g => { %>
                    <span class="fanfic-tag fanfic-tag--genre"><%= g %></span>
                <% }) %>
                <% if (fanfic.restriction) { %>
                    <span class="fanfic-tag fanfic-tag--restriction"><%= fanfic.restriction %></span>
                <% } %>
            </div>

            <div id="authorActions" class="fanfic-actions hidden">
                <button class="btn btn--secondary" onclick="editFanfic()">Edit Fanfic</button>
                <button class="btn btn--danger" onclick="deleteFanfic()">Delete Fanfic</button>
            </div>
        </div>

        <div class="card fanfic-body">
            <%- fanfic.content %>
        </div>

        <div class="card">
            <div class="section-header">
                <h2 class="section-header__title">Reviews</h2>
            </div>
            
            <div class="section-body">
                <% if (reviews && reviews.length > 0) { %>
                    <% reviews.forEach(review => { %>
                        <div class="list-item" data-review-id="<%= review.review_id %>" data-user-id="<%= review.user_id %>">
                            <div class="list-item__header">
                                <span><strong>User:</strong> <%= review.username %></span>
                                <span><strong>Rating:</strong> <%= review.rating %>/5</span>
                                <span class="item-actions hidden">
                                    <button class="btn btn--small btn--secondary" onclick="startEditReview('<%= review.review_id %>', '<%= review.comment.replace(/'/g, '&#39;') %>', <%= review.rating %>)">Edit</button>
                                    <button class="btn btn--small btn--danger" onclick="deleteReview('<%= review.review_id %>')">Delete</button>
                                </span>
                            </div>
                            <div class="list-item__text review-text"><%= review.comment %></div>
                            <div class="edit-form hidden">
                                <select class="form-input review-edit-rating">
                                    <option value="5">★★★★★ - Excellent</option>
                                    <option value="4">★★★★☆ - Good</option>
                                    <option value="3">★★★☆☆ - Okay</option>
                                    <option value="2">★★☆☆☆ - Poor</option>
                                    <option value="1">★☆☆☆☆ - Bad</option>
                                </select>
                                <textarea class="form-input review-edit-comment"></textarea>
                                <div class="edit-form__buttons">
                                    <button class="btn btn--small" onclick="saveReview('<%= review.review_id %>')">Save</button>
                                    <button class="btn btn--small btn--secondary" onclick="cancelEdit(this)">Cancel</button>
                                </div>
                            </div>
                        </div>
                    <% }) %>
                <% } else { %>
                    <div class="empty-state">No reviews yet. Be the first to leave one!</div>
                <% } %>
            </div>

            <div class="form-box">
                <h3 class="form-box__title">Leave a Review</h3>
                <select id="reviewRating" class="form-input">
                    <option value="5">★★★★★ - Excellent</option>
                    <option value="4">★★★★☆ - Good</option>
                    <option value="3">★★★☆☆ - Okay</option>
                    <option value="2">★★☆☆☆ - Poor</option>
                    <option value="1">★☆☆☆☆ - Bad</option>
                </select>
                <textarea id="reviewComment" class="form-input" placeholder="Write your review..."></textarea>
                <button class="btn" onclick="submitReview()">Post Review</button>
            </div>
        </div>

        <div class="card">
            <div class="section-header">
                <h2 class="section-header__title">Comments</h2>
            </div>
            
            <div class="section-body">
                <% if (comments && comments.length > 0) { %>
                    <% comments.forEach(comment => { %>
                        <div class="list-item" data-comment-id="<%= comment.comment_id %>" data-user-id="<%= comment.user_id %>">
                            <div class="list-item__header">
                                <span><strong>User:</strong> <%= comment.username %></span>
                                <span><%= new Date(comment.created_at).toLocaleString() %></span>
                                <span class="item-actions hidden">
                                    <button class="btn btn--small btn--secondary" onclick="startEditComment('<%= comment.comment_id %>', '<%= comment.text.replace(/'/g, '&#39;') %>')">Edit</button>
                                    <button class="btn btn--small btn--danger" onclick="deleteComment('<%= comment.comment_id %>')">Delete</button>
                                </span>
                            </div>
                            <div class="list-item__text comment-text"><%= comment.text %></div>
                            <div class="edit-form hidden">
                                <textarea class="form-input comment-edit-text"></textarea>
                                <div class="edit-form__buttons">
                                    <button class="btn btn--small" onclick="saveComment('<%= comment.comment_id %>')">Save</button>
                                    <button class="btn btn--small btn--secondary" onclick="cancelEdit(this)">Cancel</button>
                                </div>
                            </div>
                        </div>
                    <% }) %>
                <% } else { %>
                    <div class="empty-state">No comments yet. Join the conversation!</div>
                <% } %>
            </div>

            <div class="form-box">
                <h3 class="form-box__title">Leave a Comment</h3>
                <textarea id="commentText" class="form-input" placeholder="Write a comment..."></textarea>
                <button class="btn" onclick="submitComment()">Post Comment</button>
            </div>
        </div>
    </div>

    <script>
        const fanficId = '<%= fanfic.fanfic_id %>';
        const pubId = '<%= fanfic.fanfic_id %>';

        const authHeaders = () => {
            const token = localStorage.getItem('token');
            return token ? { 'Authorization': `Bearer ${token}` } : {};
        };

        const reloadPage = () => window.location.reload();

        let currentUserId = null;
        try {
            const token = localStorage.getItem('token');
            if (token) {
                const payload = JSON.parse(atob(token.split('.')[1]));
                currentUserId = payload.user_id;
                if (payload.user_id === '<%= fanfic.user_id %>') {
                    document.getElementById('authorActions')?.classList.remove('hidden');
                }
                document.querySelectorAll('[data-user-id]').forEach(el => {
                    if (el.dataset.userId === payload.user_id) {
                        el.querySelector('.item-actions')?.classList.remove('hidden');
                    }
                });
            }
        } catch(e) {
            console.error('Error parsing token', e);
        }

        const editFanfic = () => window.location.href = `/fanfic/editor/${fanficId}`;

        const deleteFanfic = async () => {
            if (!confirm('Are you sure you want to delete this fanfic?')) return;
            const res = await fetch(`/fanfic/${fanficId}`, {
                method: 'DELETE',
                headers: authHeaders()
            });
            if (res.ok) {
                alert('Fanfic deleted');
                window.location.href = '/';
            } else {
                const err = await res.json().catch(() => ({}));
                alert('Failed to delete: ' + (err.error || 'Unknown error'));
            }
        };

        const submitReview = async () => {
            const comment = document.getElementById('reviewComment').value.trim();
            const rating = document.getElementById('reviewRating').value;

            if (!comment) return alert('Please write a review comment');
            if (!localStorage.getItem('token')) return alert('Not authenticated. Please login first.');

            const res = await fetch('/review', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', ...authHeaders() },
                body: JSON.stringify({ pub_id: pubId, comment, rating: Number(rating) })
            });

            if (res.ok) reloadPage();
            else {
                const err = await res.json().catch(() => ({}));
                alert('Failed to post review: ' + (err.error || 'Unknown error'));
            }
        };

        const submitComment = async () => {
            const text = document.getElementById('commentText').value.trim();

            if (!text) return alert('Please write a comment');
            if (!localStorage.getItem('token')) return alert('Not authenticated. Please login first.');

            const res = await fetch('/comment', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', ...authHeaders() },
                body: JSON.stringify({ fanfic_id: fanficId, text })
            });

            if (res.ok) reloadPage();
            else {
                const err = await res.json().catch(() => ({}));
                alert('Failed to post comment: ' + (err.error || 'Unknown error'));
            }
        };

        const startEditReview = (id, comment, rating) => {
            const item = document.querySelector(`[data-review-id="${id}"]`);
            item.querySelector('.review-text').classList.add('hidden');
            const form = item.querySelector('.edit-form');
            form.classList.remove('hidden');
            const sel = form.querySelector('.review-edit-rating');
            sel.value = rating;
            form.querySelector('.review-edit-comment').value = comment;
        };

        const saveReview = async (id) => {
            const item = document.querySelector(`[data-review-id="${id}"]`);
            const form = item.querySelector('.edit-form');
            const comment = form.querySelector('.review-edit-comment').value.trim();
            const rating = Number(form.querySelector('.review-edit-rating').value);
            if (!comment) return alert('Review text cannot be empty');
            const res = await fetch(`/review/${id}`, {
                method: 'PUT',
                headers: { 'Content-Type': 'application/json', ...authHeaders() },
                body: JSON.stringify({ comment, rating })
            });
            if (res.ok) reloadPage();
            else {
                const err = await res.json().catch(() => ({}));
                alert('Failed to update review: ' + (err.error || 'Unknown error'));
            }
        };

        const deleteReview = async (id) => {
            if (!confirm('Delete this review?')) return;
            const res = await fetch(`/review/${id}`, { method: 'DELETE', headers: authHeaders() });
            if (res.ok) reloadPage();
            else {
                const err = await res.json().catch(() => ({}));
                alert('Failed to delete review: ' + (err.error || 'Unknown error'));
            }
        };

        const startEditComment = (id, text) => {
            const item = document.querySelector(`[data-comment-id="${id}"]`);
            item.querySelector('.comment-text').classList.add('hidden');
            const form = item.querySelector('.edit-form');
            form.classList.remove('hidden');
            form.querySelector('.comment-edit-text').value = text;
        };

        const saveComment = async (id) => {
            const item = document.querySelector(`[data-comment-id="${id}"]`);
            const text = item.querySelector('.comment-edit-text').value.trim();
            if (!text) return alert('Comment cannot be empty');
            const res = await fetch(`/comment/${id}`, {
                method: 'PUT',
                headers: { 'Content-Type': 'application/json', ...authHeaders() },
                body: JSON.stringify({ text })
            });
            if (res.ok) reloadPage();
            else {
                const err = await res.json().catch(() => ({}));
                alert('Failed to update comment: ' + (err.error || 'Unknown error'));
            }
        };

        const deleteComment = async (id) => {
            if (!confirm('Delete this comment?')) return;
            const res = await fetch(`/comment/${id}`, { method: 'DELETE', headers: authHeaders() });
            if (res.ok) reloadPage();
            else {
                const err = await res.json().catch(() => ({}));
                alert('Failed to delete comment: ' + (err.error || 'Unknown error'));
            }
        };

        const cancelEdit = (btn) => {
            const form = btn.closest('.edit-form');
            const item = form.closest('.list-item');
            form.classList.add('hidden');
            item.querySelector('.review-text, .comment-text')?.classList.remove('hidden');
        };

        Object.assign(window, {
            submitReview, submitComment, editFanfic, deleteFanfic,
            startEditReview, saveReview, deleteReview,
            startEditComment, saveComment, deleteComment, cancelEdit
        });
    </script>
</body>
</html>
