<!DOCTYPE html>
<html>
<head>
    <title>Fanfic Editor</title>
    <link rel="stylesheet" href="/styles/createEdit.css">
    <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
</head>
<body>
    <div class="container">
        <div class="editor">
            <div class="meta">
                <% if (fanfic.fanfic_id) { %>
                <input type="hidden" id="fanficId" value="<%= fanfic.fanfic_id %>">
                <% } %>
                <input type="text" id="title" value="<%= fanfic.title %>" placeholder="Title">
                <input type="text" id="desc" value="<%= fanfic.description %>" placeholder="Description">
                <select id="genre">
                    <option value="">Select Genre</option>
                    <option value="Fantasy" <%= fanfic.genre && fanfic.genre.includes('Fantasy') ? 'selected' : '' %>>Fantasy</option>
                    <option value="Romance" <%= fanfic.genre && fanfic.genre.includes('Romance') ? 'selected' : '' %>>Romance</option>
                    <option value="Drama" <%= fanfic.genre && fanfic.genre.includes('Drama') ? 'selected' : '' %>>Drama</option>
                    <option value="Comedy" <%= fanfic.genre && fanfic.genre.includes('Comedy') ? 'selected' : '' %>>Comedy</option>
                    <option value="Action" <%= fanfic.genre && fanfic.genre.includes('Action') ? 'selected' : '' %>>Action</option>
                    <option value="Mystery" <%= fanfic.genre && fanfic.genre.includes('Mystery') ? 'selected' : '' %>>Mystery</option>
                    <option value="Sci-Fi" <%= fanfic.genre && fanfic.genre.includes('Sci-Fi') ? 'selected' : '' %>>Sci-Fi</option>
                    <option value="Horror" <%= fanfic.genre && fanfic.genre.includes('Horror') ? 'selected' : '' %>>Horror</option>
                </select>
            </div>
            <textarea id="content" placeholder="Write your fanfic here..."><%= fanfic.content %></textarea>
        </div>
        <div class="preview">
            <h3 id="previewTitle"><%= fanfic.title %></h3>
            <p id="previewDesc"><%= fanfic.description %></p>
            <div id="preview"></div>
        </div>
    </div>
    <div class="toolbar">
        <button onclick="saveFanfic()">Save</button>
    </div>
    <script>
        const content = document.getElementById('content');
        const preview = document.getElementById('preview');
        const title = document.getElementById('title');
        const desc = document.getElementById('desc');

        const updatePreview = () => {
            preview.innerHTML = marked.parse(content.value);
            document.getElementById('previewTitle').textContent = title.value || 'Title';
            document.getElementById('previewDesc').textContent = desc.value || 'Description';
        };
        content.addEventListener('input', updatePreview);
        title.addEventListener('input', updatePreview);
        desc.addEventListener('input', updatePreview);
        updatePreview();

        const saveFanfic = async () => {
            const genre = document.getElementById('genre').value.trim();
            
            if (!genre) {
                alert('Please select a Genre');
                return;
            }
            
            const token = localStorage.getItem('token');
            if (!token) {
                alert('Not authenticated. Please login first.');
                return;
            }
            
            const fanficIdInput = document.getElementById('fanficId');
            const fanficId = fanficIdInput ? fanficIdInput.value : null;
            const isUpdate = !!fanficId;
            const method = isUpdate ? 'PUT' : 'POST';
            const url = isUpdate ? `/fanfic/${fanficId}` : '/fanfic';
            
            const data = {
                title: title.value,
                description: desc.value,
                genre: [genre],
                content: content.value
            };
            
            const res = await fetch(url, { 
                method, 
                headers: { 
                    'Content-Type': 'application/json',
                    'Authorization': `Bearer ${token}`
                }, 
                body: JSON.stringify(data) 
            });
            
            if (res.ok) {
                const result = await res.json();
                alert((isUpdate ? 'Updated' : 'Created') + '! ID: ' + result.fanfic_id);
            } else {
                const error = await res.json();
                alert('Save failed! ' + (error.error || error.message || 'Unknown error'));
            }
        };
        window.saveFanfic = saveFanfic;
    </script>
</body>
</html>